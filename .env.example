# Get free key at https://aistudio.google.com/apikey (15 requests/min free)
GEMINI_API_KEY=

# Optional: fall back to Groq (also free) — https://console.groq.com/keys
GROQ_API_KEY=

# YouTube — see README upload section
YOUTUBE_CLIENT_SECRETS_FILE=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
YOUTUBE_CHANNEL_DESC_TAGS=hinduism,bhakti,sanatan,shorts,reels

# Instagram Graph API (requires FB Business account + linked IG Business/Creator account)
IG_USER_ID=
IG_ACCESS_TOKEN=
